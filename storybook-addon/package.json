{
  "name": "storybook-addon-iconsearch",
  "version": "0.1.0",
  "description": "Search IconSearch from Storybook and copy production-ready icon snippets.",
  "author": "iconsearch",
  "license": "MIT",
  "homepage": "https://iconsearch.info",
  "repository": {
    "type": "git",
    "url": "https://github.com/sg-2512/iconsearch.git",
    "directory": "storybook-addon"
  },
  "bugs": {
    "url": "https://github.com/sg-2512/iconsearch/issues"
  },
  "type": "module",
  "main": "preset.js",
  "types": "dist/manager.d.ts",
  "files": [
    "dist",
    "preset.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/manager.tsx --format esm --dts --clean",
    "dev": "tsup src/manager.tsx --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "storybook": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "^10.5.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "storybook-addon",
    "design",
    "icons",
    "svg",
    "react",
    "tailwind",
    "iconsearch"
  ],
  "storybook": {
    "displayName": "IconSearch",
    "supportedFrameworks": [
      "react",
      "vue",
      "angular",
      "web-components",
      "svelte",
      "preact",
      "html"
    ]
  }
}
