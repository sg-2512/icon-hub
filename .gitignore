# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local scratch/debug scripts
/scratch/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev.*.log

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large files
/data/iconify-icon-search.json
/data/iconify-icon-search.json.gz

# packaged plugin/extension outputs
/framer-plugin/node_modules
/framer-plugin/dist
/framer-plugin/plugin.zip
/dist/
/public/downloads/iconsearch-chrome-extension.zip
