{
  "name": "iconsearch-google-slides-addon",
  "version": "0.1.0",
  "private": true,
  "description": "Search, style, and insert open-source icons in Google Slides.",
  "author": "IconSearch",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "check": "npm run build && node scripts/check-addon.mjs",
    "verify": "npm run typecheck && npm test && npm run check",
    "dev-server": "vite --host 0.0.0.0 --port 3008",
    "login": "clasp login",
    "push": "npm run build && clasp push",
    "open": "clasp open-script"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
