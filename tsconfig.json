{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "adobe-plugin",
    "canva-app",
    "chrome-extension",
    "figma-plugin",
    "framer-plugin",
    "google-slides-addon",
    "jetbrains-plugin",
    "mcp-server",
    "obsidian-plugin",
    "powerpoint-addin",
    "raycast-extension",
    "shopify-extension",
    "sketch-plugin",
    "storybook-addon",
    "tailwind-plugin",
    "vscode-extension",
    "webflow-extension",
    "wordpress-plugin"
  ]
}

